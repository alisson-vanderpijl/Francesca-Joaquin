# Contraseña para acceder a /admin
ADMIN_PASSWORD=elige-una-contraseña-segura

# Secreto para firmar la sesión (opcional; usa ADMIN_PASSWORD si no se define)
ADMIN_SECRET=your-random-secret-here

# Neon Postgres (producción y/o local). Sin esto, los RSVPs se guardan en data/rsvps.json.
# Neon → Dashboard → Connection string → pooled (recomendado para serverless).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
